# Application
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_secret
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase (server-side values; never expose the service-role key in frontend code)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_supabase_service_role_key

# Transactional email
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace_with_your_smtp_username
SMTP_PASS=replace_with_your_smtp_password
SMTP_FROM=DOMIKNOW <no-reply@example.com>

# PORT is supplied automatically by Render. Use this only for local overrides.
PORT=3000



